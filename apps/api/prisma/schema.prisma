// Prisma schema for the ERP. Every migration's SQL is reviewed before merge (constraints, indexes,
// locking). Triggers, check and exclusion constraints live in hand-written migration SQL; see
// docs/ERD_PHASE1.md.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "platform", "iam", "org", "accounting", "reporting", "crm", "workshop", "inventory", "purchasing"]
}

enum RecordStatus {
  active
  inactive

  @@schema("platform")
}

// ───────────────────────────── org ─────────────────────────────

model Company {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String
  legalName    String       @map("legal_name")
  legalNameAr  String?      @map("legal_name_ar")
  baseCurrency String       @map("base_currency") @db.Char(3)
  timezone     String
  status       RecordStatus @default(active)
  version      Int          @default(1)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Letterhead (optional; printed on quotes, invoices and job sheets).
  crNumber     String?      @map("cr_number")
  address      String?
  addressAr    String?      @map("address_ar")
  phone        String?

  branches        Branch[]
  roles           Role[]
  roleAssignments RoleAssignment[]
  accounts        Account[]
  fiscalPeriods   FiscalPeriod[]
  journals        Journal[]
  journalLines    JournalLine[]
  exportJobs      ExportJob[]
  notifications   Notification[]
  customers       Customer[]
  vehicles        Vehicle[]
  jobCards        JobCard[]
  appointments    Appointment[]
  logo            CompanyLogo?
  taxCodes        TaxCode[]
  taxSettings     TaxSettings?
  pricingSettings PricingSettings?
  labourRates     LabourRate[]
  suppliers       Supplier[]

  @@map("company")
  @@schema("org")
}

model Branch {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  code      String
  name      String
  nameAr    String?      @map("name_ar")
  status    RecordStatus @default(active)
  version   Int          @default(1)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  roleAssignments  RoleAssignment[]
  journals         Journal[]
  jobCards         JobCard[]
  workshopSchedule WorkshopSchedule?
  workshopHours    WorkshopHours[]
  appointments     Appointment[]
  bays             Bay[]
  labourRates      LabourRate[]
  stock            Stock[]
  stockMovements   StockMovement[]
  supplierBills    SupplierBill[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@map("branch")
  @@schema("org")
}

// ───────────────────────────── iam ─────────────────────────────

model User {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  oidcIssuer      String       @map("oidc_issuer")
  oidcSubject     String       @map("oidc_subject")
  email           String
  displayName     String       @map("display_name")
  locale          String       @default("en")
  isPlatformAdmin Boolean      @default(false) @map("is_platform_admin")
  status          RecordStatus @default(active)
  version         Int          @default(1)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  roleAssignments RoleAssignment[] @relation("assignee")
  exportJobs      ExportJob[]
  notifications   Notification[]

  @@unique([oidcIssuer, oidcSubject])
  @@map("user")
  @@schema("iam")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  code        String
  name        String
  nameAr      String?  @map("name_ar")
  permissions String[]
  isSystem    Boolean  @default(false) @map("is_system")
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  assignments RoleAssignment[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@map("role")
  @@schema("iam")
}

model RoleAssignment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  /// null = every branch of the company
  branchId  String?  @map("branch_id") @db.Uuid
  grantedBy String?  @map("granted_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user    User    @relation("assignee", fields: [userId], references: [id], onDelete: Restrict)
  role    Role    @relation(fields: [companyId, roleId], references: [companyId, id], onDelete: Restrict)
  branch  Branch? @relation(fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict)

  /// Created in SQL with NULLS NOT DISTINCT so a NULL branch (all branches) is unique too.
  @@unique([userId, roleId, branchId], map: "role_assignment_unique")
  @@index([userId, companyId])
  @@map("role_assignment")
  @@schema("iam")
}

// ─────────────────────────── platform ──────────────────────────

model AuditEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  requestId   String?  @map("request_id")
  actorUserId String?  @map("actor_user_id") @db.Uuid
  companyId   String?  @map("company_id") @db.Uuid
  branchId    String?  @map("branch_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  reason      String?
  before      Json?
  after       Json?

  @@index([companyId, occurredAt(sort: Desc), id(sort: Desc)])
  @@index([entityType, entityId])
  @@map("audit_event")
  @@schema("platform")
}

model OutboxEvent {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String?   @map("company_id") @db.Uuid
  aggregateType  String    @map("aggregate_type")
  aggregateId    String    @map("aggregate_id")
  eventType      String    @map("event_type")
  payload        Json
  occurredAt     DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  /// Who caused the event (null for system events and events recorded before this column).
  actorUserId    String?   @map("actor_user_id") @db.Uuid
  /// Set when delivery failed too often; the event is then left for an operator to inspect.
  deadLetteredAt DateTime? @map("dead_lettered_at") @db.Timestamptz(6)

  @@index([publishedAt, availableAt])
  @@map("outbox_event")
  @@schema("platform")
}

model DocumentSequence {
  companyId String @map("company_id") @db.Uuid
  docType   String @map("doc_type")
  series    String
  nextValue BigInt @map("next_value")

  @@id([companyId, docType, series])
  @@map("document_sequence")
  @@schema("platform")
}

// ────────────────────────── accounting ─────────────────────────

enum AccountType {
  asset
  liability
  equity
  revenue
  expense

  @@schema("accounting")
}

enum AccountReportingClass {
  cash
  bank
  receivable
  payable
  inventory
  cogs

  @@schema("accounting")
}

enum PeriodStatus {
  open
  closed

  @@schema("accounting")
}

enum JournalSource {
  manual
  reversal
  invoice
  payment
  stock
  supplier_bill
  supplier_payment

  @@schema("accounting")
}

model Account {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String                 @map("company_id") @db.Uuid
  code           String
  name           String
  nameAr         String?                @map("name_ar")
  type           AccountType
  parentId       String?                @map("parent_id") @db.Uuid
  isPosting      Boolean                @map("is_posting")
  /// Explicit classification used by reports (cash position, gross profit); null = none.
  reportingClass AccountReportingClass? @map("reporting_class")
  status         RecordStatus           @default(active)
  version        Int                    @default(1)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  parent   Account?      @relation("hierarchy", fields: [companyId, parentId], references: [companyId, id], onDelete: Restrict)
  children Account[]     @relation("hierarchy")
  lines    JournalLine[]
  taxCodes TaxCode[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@map("account")
  @@schema("accounting")
}

model FiscalPeriod {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  name      String
  startDate DateTime     @map("start_date") @db.Date
  endDate   DateTime     @map("end_date") @db.Date
  status    PeriodStatus @default(open)
  closedAt  DateTime?    @map("closed_at") @db.Timestamptz(6)
  closedBy  String?      @map("closed_by") @db.Uuid
  version   Int          @default(1)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  journals Journal[]

  @@unique([companyId, id])
  @@unique([companyId, name])
  @@map("fiscal_period")
  @@schema("accounting")
}

model Journal {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  branchId       String?       @map("branch_id") @db.Uuid
  fiscalPeriodId String        @map("fiscal_period_id") @db.Uuid
  number         String
  postingDate    DateTime      @map("posting_date") @db.Date
  description    String
  currency       String        @db.Char(3)
  totalDebit     Decimal       @map("total_debit") @db.Decimal(20, 6)
  totalCredit    Decimal       @map("total_credit") @db.Decimal(20, 6)
  sourceType     JournalSource @map("source_type")
  sourceId       String?       @map("source_id")
  reversalOfId   String?       @unique @map("reversal_of_id") @db.Uuid
  idempotencyKey String        @map("idempotency_key")
  requestHash    String        @map("request_hash")
  postedBy       String        @map("posted_by") @db.Uuid
  postedAt       DateTime      @default(now()) @map("posted_at") @db.Timestamptz(6)

  company    Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch     Branch?       @relation(fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict)
  period     FiscalPeriod  @relation(fields: [companyId, fiscalPeriodId], references: [companyId, id], onDelete: Restrict)
  reversalOf Journal?      @relation("reversal", fields: [companyId, reversalOfId], references: [companyId, id], onDelete: Restrict)
  reversedBy Journal[]     @relation("reversal")
  lines      JournalLine[]

  @@unique([companyId, id])
  @@unique([companyId, number])
  @@unique([companyId, idempotencyKey])
  @@unique([companyId, sourceType, sourceId])
  @@index([companyId, postedAt(sort: Desc), id(sort: Desc)])
  @@index([companyId, postingDate])
  @@map("journal")
  @@schema("accounting")
}

model JournalLine {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String  @map("company_id") @db.Uuid
  journalId   String  @map("journal_id") @db.Uuid
  lineNo      Int     @map("line_no")
  accountId   String  @map("account_id") @db.Uuid
  branchId    String? @map("branch_id") @db.Uuid
  description String?
  debit       Decimal @default(0) @db.Decimal(20, 6)
  credit      Decimal @default(0) @db.Decimal(20, 6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  journal Journal @relation(fields: [companyId, journalId], references: [companyId, id], onDelete: Restrict)
  account Account @relation(fields: [companyId, accountId], references: [companyId, id], onDelete: Restrict)

  @@unique([journalId, lineNo])
  @@index([companyId, accountId])
  @@map("journal_line")
  @@schema("accounting")
}

// ─────────────────────────── exports (WEB-205) ──────────────────────────

/// One requested report file. PostgreSQL is authoritative for status; the BullMQ message carries
/// only the id. Files live here for EXPORT_RETENTION_DAYS, then the content is deleted.
model ExportJob {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  requestedBy      String    @map("requested_by") @db.Uuid
  kind             String
  format           String
  locale           String
  params           Json
  status           String    @default("queued")
  /// Branch scope the file was produced with (copied at generation); downloads must still cover it.
  scopeAllBranches Boolean   @default(false) @map("scope_all_branches")
  scopeBranchIds   String[]  @default([]) @map("scope_branch_ids") @db.Uuid
  attempts         Int       @default(0)
  error            String?
  rowCount         Int?      @map("row_count")
  fileName         String?   @map("file_name")
  contentType      String?   @map("content_type")
  sizeBytes        Int?      @map("size_bytes")
  content          Bytes?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt        DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz(6)
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  requester User    @relation(fields: [requestedBy], references: [id], onDelete: Restrict)

  @@index([companyId, requestedBy, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("export_job")
  @@schema("platform")
}

// ─────────────────────────── notifications ──────────────────────────

/// One message for one person, created by the outbox dispatcher from a committed business event.
/// Text is rendered by the client from `kind` and `params` in the reader's language.
model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  eventId   String    @map("event_id") @db.Uuid
  kind      String
  params    Json
  /// Path inside the company, e.g. "journals/<id>"; null when there is nothing to open.
  link      String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([eventId, userId])
  @@index([userId, companyId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("notification")
  @@schema("platform")
}

// ─────────────────────────── crm (WMS-001, CRM-001/002) ──────────────────────────

model Customer {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  kind      String       @default("individual")
  name      String
  nameAr    String?      @map("name_ar")
  phone     String
  email     String?
  notes     String?
  status    RecordStatus @default(active)
  version   Int          @default(1)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  vehicles     Vehicle[]
  jobCards     JobCard[]
  appointments Appointment[]

  @@unique([companyId, id])
  @@index([companyId, phone])
  @@map("customer")
  @@schema("crm")
}

/// A vehicle and its current owner. Plate and VIN are unique within the company.
model Vehicle {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String       @map("company_id") @db.Uuid
  customerId String       @map("customer_id") @db.Uuid
  plate      String
  vin        String?
  make       String
  model      String
  year       Int?
  color      String?
  status     RecordStatus @default(active)
  version    Int          @default(1)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer     Customer      @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: Restrict)
  jobCards     JobCard[]
  appointments Appointment[]

  @@unique([companyId, id])
  @@unique([companyId, plate])
  @@unique([companyId, vin])
  @@map("vehicle")
  @@schema("crm")
}

// ─────────────────────────── workshop (WMS-006/010/011) ──────────────────────────

/// A repair job for one vehicle at one branch. Status changes only through JobService, which
/// checks the transition, the actor's permission and the version, and writes a JobEvent.
model JobCard {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId               String    @map("company_id") @db.Uuid
  branchId                String    @map("branch_id") @db.Uuid
  number                  String
  customerId              String    @map("customer_id") @db.Uuid
  vehicleId               String    @map("vehicle_id") @db.Uuid
  status                  String    @default("draft")
  complaint               String
  odometerIn              Int       @map("odometer_in")
  fuelLevel               String    @map("fuel_level")
  promisedAt              DateTime? @map("promised_at") @db.Timestamptz(6)
  authorizedByName        String?   @map("authorized_by_name")
  authorizedVia           String?   @map("authorized_via")
  authorizedAt            DateTime? @map("authorized_at") @db.Timestamptz(6)
  authorizationRecordedBy String?   @map("authorization_recorded_by") @db.Uuid
  reworkCount             Int       @default(0) @map("rework_count")
  deliveredToName         String?   @map("delivered_to_name")
  deliveredAt             DateTime? @map("delivered_at") @db.Timestamptz(6)
  odometerOut             Int?      @map("odometer_out")
  cancelledReason         String?   @map("cancelled_reason")
  createdBy               String    @map("created_by") @db.Uuid
  /// Check-in inspection: when and by whom the checklist was recorded (required before authorisation).
  inspectedAt             DateTime? @map("inspected_at") @db.Timestamptz(6)
  inspectedBy             String?   @map("inspected_by") @db.Uuid
  /// The bay the car is on now (WEB-022); cleared on delivery or cancellation.
  bayId                   String?   @map("bay_id") @db.Uuid
  /// The owner let the car leave before its invoice was paid (T-72).
  unpaidReleaseBy         String?   @map("unpaid_release_by") @db.Uuid
  unpaidReleaseAt         DateTime? @map("unpaid_release_at") @db.Timestamptz(6)
  unpaidReleaseReason     String?   @map("unpaid_release_reason")
  version                 Int       @default(1)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch          Branch           @relation(fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict)
  customer        Customer         @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: Restrict)
  vehicle         Vehicle          @relation(fields: [companyId, vehicleId], references: [companyId, id], onDelete: Restrict)
  tasks           JobTask[]
  events          JobEvent[]
  inspectionItems InspectionItem[]
  appointment     Appointment?
  photos          JobPhoto[]
  timeEntries     TaskTimeEntry[]
  additions       JobAddition[]
  quotes          Quote[]
  invoices        Invoice[]
  parts           JobPart[]
  bay             Bay?             @relation(fields: [bayId], references: [id], onDelete: Restrict)

  @@unique([companyId, id])
  @@unique([companyId, number])
  @@index([companyId, status, createdAt(sort: Desc)])
  @@index([companyId, vehicleId, createdAt(sort: Desc)])
  @@map("job_card")
  @@schema("workshop")
}

model JobTask {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  jobId          String    @map("job_id") @db.Uuid
  lineNo         Int       @map("line_no")
  description    String
  estimatedHours Decimal   @map("estimated_hours") @db.Decimal(5, 2)
  technicianId   String?   @map("technician_id") @db.Uuid
  status         String    @default("open")
  doneAt         DateTime? @map("done_at") @db.Timestamptz(6)
  doneBy         String?   @map("done_by") @db.Uuid
  /// Set when the task came from approved additional work (WEB-025).
  additionId     String?   @map("addition_id") @db.Uuid

  job         JobCard         @relation(fields: [companyId, jobId], references: [companyId, id], onDelete: Cascade)
  timeEntries TaskTimeEntry[]
  quoteLines  QuoteLine[]
  addition    JobAddition?    @relation(fields: [additionId], references: [id], onDelete: Restrict)

  @@unique([jobId, id])
  @@unique([jobId, lineNo])
  @@index([companyId, technicianId])
  @@map("job_task")
  @@schema("workshop")
}

/// Append-only job timeline (status changes, assignments, QC results, notes).
model JobEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  jobId       String   @map("job_id") @db.Uuid
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorUserId String   @map("actor_user_id") @db.Uuid
  kind        String
  fromStatus  String?  @map("from_status")
  toStatus    String?  @map("to_status")
  note        String?
  data        Json?

  job JobCard @relation(fields: [companyId, jobId], references: [companyId, id], onDelete: Restrict)

  @@index([jobId, occurredAt])
  @@map("job_event")
  @@schema("workshop")
}

/// One answer of the check-in checklist (keys from INSPECTION_ITEMS in @erp/validation).
model InspectionItem {
  companyId String  @map("company_id") @db.Uuid
  jobId     String  @map("job_id") @db.Uuid
  itemKey   String  @map("item_key")
  status    String
  note      String?

  job JobCard @relation(fields: [companyId, jobId], references: [companyId, id], onDelete: Restrict)

  @@id([jobId, itemKey])
  @@map("inspection_item")
  @@schema("workshop")
}

/// A photo of the vehicle, re-encoded by the server (metadata such as GPS removed) with a thumbnail.
model JobPhoto {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  jobId      String   @map("job_id") @db.Uuid
  area       String
  caption    String?
  content    Bytes
  thumbnail  Bytes
  width      Int
  height     Int
  sizeBytes  Int      @map("size_bytes")
  sha256     String
  uploadedBy String   @map("uploaded_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  job JobCard @relation(fields: [companyId, jobId], references: [companyId, id], onDelete: Restrict)

  @@index([jobId, createdAt])
  @@map("job_photo")
  @@schema("workshop")
}

// ─────────────────────────── appointments (WMS-002) ──────────────────────────

/// Bays and slot length of a branch's workshop. Missing = not configured (booking refused).
model WorkshopSchedule {
  companyId   String   @map("company_id") @db.Uuid
  branchId    String   @id @map("branch_id") @db.Uuid
  bays        Int
  slotMinutes Int      @map("slot_minutes")
  version     Int      @default(1)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch Branch @relation(fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict)

  @@unique([companyId, branchId])
  @@map("workshop_schedule")
  @@schema("workshop")
}

/// Opening hours per weekday (0 = Sunday) in the company's time zone; a missing day is closed.
model WorkshopHours {
  companyId    String @map("company_id") @db.Uuid
  branchId     String @map("branch_id") @db.Uuid
  weekday      Int
  opensMinute  Int    @map("opens_minute")
  closesMinute Int    @map("closes_minute")

  branch Branch @relation(fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict)

  @@id([branchId, weekday])
  @@map("workshop_hours")
  @@schema("workshop")
}

model Appointment {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  branchId        String   @map("branch_id") @db.Uuid
  customerId      String   @map("customer_id") @db.Uuid
  vehicleId       String   @map("vehicle_id") @db.Uuid
  startsAt        DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime @map("ends_at") @db.Timestamptz(6)
  service         String
  notes           String?
  status          String   @default("booked")
  jobId           String?  @unique @map("job_id") @db.Uuid
  cancelledReason String?  @map("cancelled_reason")
  createdBy       String   @map("created_by") @db.Uuid
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch   Branch   @relation(fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict)
  customer Customer @relation(fields: [companyId, customerId], references: [companyId, id], onDelete: Restrict)
  vehicle  Vehicle  @relation(fields: [companyId, vehicleId], references: [companyId, id], onDelete: Restrict)
  job      JobCard? @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@unique([companyId, id])
  @@index([branchId, startsAt])
  @@index([vehicleId, startsAt])
  @@map("appointment")
  @@schema("workshop")
}

/// Technician time on a job task (WMS-007, WEB-023). Clocked live or, when forgotten, entered by a
/// manager with a reason. Never edited or deleted once closed: a wrong entry is voided with a
/// reason. The database allows one open entry per technician and no overlapping entries.
model TaskTimeEntry {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  branchId     String    @map("branch_id") @db.Uuid
  jobId        String    @map("job_id") @db.Uuid
  taskId       String    @map("task_id") @db.Uuid
  technicianId String    @map("technician_id") @db.Uuid
  startedAt    DateTime  @map("started_at") @db.Timestamptz(6)
  endedAt      DateTime? @map("ended_at") @db.Timestamptz(6)
  /// clock | manual
  source       String
  reason       String?
  createdBy    String    @map("created_by") @db.Uuid
  endedBy      String?   @map("ended_by") @db.Uuid
  voidedAt     DateTime? @map("voided_at") @db.Timestamptz(6)
  voidedBy     String?   @map("voided_by") @db.Uuid
  voidReason   String?   @map("void_reason")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  job  JobCard @relation(fields: [companyId, jobId], references: [companyId, id], onDelete: Restrict)
  task JobTask @relation(fields: [jobId, taskId], references: [jobId, id], onDelete: Restrict)

  @@index([jobId])
  @@index([companyId, technicianId, startedAt])
  @@index([companyId, branchId, startedAt])
  @@map("task_time_entry")
  @@schema("workshop")
}

/// Additional work found during a job (WMS-009, WEB-025): proposed, then approved by the customer
/// (its tasks join the job), declined or withdrawn. Decided proposals are never changed.
model JobAddition {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  jobId            String    @map("job_id") @db.Uuid
  seq              Int
  finding          String
  /// proposed | approved | declined | withdrawn
  status           String    @default("proposed")
  proposedBy       String    @map("proposed_by") @db.Uuid
  proposedAt       DateTime  @default(now()) @map("proposed_at") @db.Timestamptz(6)
  authorizedByName String?   @map("authorized_by_name")
  authorizedVia    String?   @map("authorized_via")
  decidedAt        DateTime? @map("decided_at") @db.Timestamptz(6)
  decidedBy        String?   @map("decided_by") @db.Uuid
  /// Why it was declined or withdrawn.
  closeReason      String?   @map("close_reason")

  job   JobCard           @relation(fields: [companyId, jobId], references: [companyId, id], onDelete: Restrict)
  items JobAdditionItem[]
  tasks JobTask[]

  @@unique([jobId, seq])
  @@map("job_addition")
  @@schema("workshop")
}

model JobAdditionItem {
  additionId     String  @map("addition_id") @db.Uuid
  lineNo         Int     @map("line_no")
  description    String
  estimatedHours Decimal @map("estimated_hours") @db.Decimal(5, 2)

  addition JobAddition @relation(fields: [additionId], references: [id], onDelete: Restrict)

  @@id([additionId, lineNo])
  @@map("job_addition_item")
  @@schema("workshop")
}

/// A named workshop bay of a branch (WEB-022). Holds at most one job at a time.
model Bay {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  code      String
  name      String
  active    Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  branch Branch    @relation(fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict)
  jobs   JobCard[]

  @@unique([branchId, code])
  @@map("bay")
  @@schema("workshop")
}

/// Company logo, re-encoded to PNG by the server (letterhead).
model CompanyLogo {
  companyId String   @id @map("company_id") @db.Uuid
  png       Bytes
  width     Int
  height    Int
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("company_logo")
  @@schema("org")
}

/// A tax the accountant sets up for the company's country (D-05); rates change by date.
model TaxCode {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  code            String
  name            String
  nameAr          String?  @map("name_ar")
  active          Boolean  @default(true)
  /// Liability posting account the tax is owed to (used by invoices).
  outputAccountId String?  @map("output_account_id") @db.Uuid
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  outputAccount Account?      @relation(fields: [companyId, outputAccountId], references: [companyId, id], onDelete: Restrict)
  rates         TaxRate[]
  defaultFor    TaxSettings[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@map("tax_code")
  @@schema("accounting")
}

/// The rate of a tax code from a date onwards. Past and current rates are never changed.
model TaxRate {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  taxCodeId     String   @map("tax_code_id") @db.Uuid
  ratePct       Decimal  @map("rate_pct") @db.Decimal(7, 4)
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  taxCode TaxCode @relation(fields: [companyId, taxCodeId], references: [companyId, id], onDelete: Restrict)

  @@unique([taxCodeId, effectiveFrom])
  @@map("tax_rate")
  @@schema("accounting")
}

model TaxSettings {
  companyId         String  @id @map("company_id") @db.Uuid
  pricesIncludeTax  Boolean @default(false) @map("prices_include_tax")
  defaultTaxCodeId  String? @map("default_tax_code_id") @db.Uuid
  taxRegistrationNo String? @map("tax_registration_no")
  version           Int     @default(1)

  company        Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  defaultTaxCode TaxCode? @relation(fields: [companyId, defaultTaxCodeId], references: [companyId, id], onDelete: Restrict)

  @@map("tax_settings")
  @@schema("accounting")
}

/// Labour price per hour at a branch from a date onwards (company currency).
model LabourRate {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  branchId      String   @map("branch_id") @db.Uuid
  rate          Decimal  @db.Decimal(12, 2)
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch  Branch  @relation(fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict)

  @@unique([branchId, effectiveFrom])
  @@map("labour_rate")
  @@schema("workshop")
}

model PricingSettings {
  companyId               String  @id @map("company_id") @db.Uuid
  /// Largest discount a manager may give; above it the owner approves.
  managerDiscountLimitPct Decimal @default(0) @map("manager_discount_limit_pct") @db.Decimal(7, 4)
  version                 Int     @default(1)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("pricing_settings")
  @@schema("workshop")
}

/// A priced estimate of a job (WMS-005, T-71): revisions per job; a draft is editable, an issued
/// quote is numbered and frozen until the customer approves or declines it, or a newer one
/// supersedes it.
model Quote {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  branchId           String    @map("branch_id") @db.Uuid
  jobId              String    @map("job_id") @db.Uuid
  revision           Int
  number             String?
  /// draft | issued | approved | declined | superseded
  status             String    @default("draft")
  currency           String    @db.Char(3)
  quoteDate          DateTime? @map("quote_date") @db.Date
  discountPct        Decimal   @default(0) @map("discount_pct") @db.Decimal(7, 4)
  discountReason     String?   @map("discount_reason")
  discountSetBy      String?   @map("discount_set_by") @db.Uuid
  discountApprovedBy String?   @map("discount_approved_by") @db.Uuid
  discountApprovedAt DateTime? @map("discount_approved_at") @db.Timestamptz(6)
  taxCodeId          String?   @map("tax_code_id") @db.Uuid
  taxCode            String?   @map("tax_code")
  taxPct             Decimal?  @map("tax_pct") @db.Decimal(7, 4)
  pricesIncludeTax   Boolean   @default(false) @map("prices_include_tax")
  subtotal           Decimal   @default(0) @db.Decimal(14, 2)
  discountAmount     Decimal   @default(0) @map("discount_amount") @db.Decimal(14, 2)
  netAmount          Decimal   @default(0) @map("net_amount") @db.Decimal(14, 2)
  taxAmount          Decimal   @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total              Decimal   @default(0) @db.Decimal(14, 2)
  issuedAt           DateTime? @map("issued_at") @db.Timestamptz(6)
  issuedBy           String?   @map("issued_by") @db.Uuid
  decidedAt          DateTime? @map("decided_at") @db.Timestamptz(6)
  decidedBy          String?   @map("decided_by") @db.Uuid
  authorizedByName   String?   @map("authorized_by_name")
  authorizedVia      String?   @map("authorized_via")
  declineReason      String?   @map("decline_reason")
  createdBy          String    @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  version            Int       @default(1)

  job      JobCard     @relation(fields: [companyId, jobId], references: [companyId, id], onDelete: Restrict)
  lines    QuoteLine[]
  invoices Invoice[]

  @@unique([jobId, revision])
  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("quote")
  @@schema("workshop")
}

model QuoteLine {
  quoteId        String   @map("quote_id") @db.Uuid
  lineNo         Int      @map("line_no")
  jobId          String   @map("job_id") @db.Uuid
  /// labour (task: hours × rate) | part (job part: quantity × unit price, in hours and rate)
  kind           String   @default("labour")
  taskId         String?  @map("task_id") @db.Uuid
  jobPartId      String?  @map("job_part_id") @db.Uuid
  description    String
  hours          Decimal  @db.Decimal(12, 3)
  rate           Decimal  @db.Decimal(12, 2)
  overrideAmount Decimal? @map("override_amount") @db.Decimal(14, 2)
  overrideReason String?  @map("override_reason")
  amount         Decimal  @db.Decimal(14, 2)

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  task    JobTask? @relation(fields: [jobId, taskId], references: [jobId, id], onDelete: Restrict)
  jobPart JobPart? @relation(fields: [jobPartId], references: [id], onDelete: Restrict)

  @@id([quoteId, lineNo])
  @@unique([quoteId, taskId])
  @@unique([quoteId, jobPartId])
  @@map("quote_line")
  @@schema("workshop")
}

/// The accountant's posting accounts for workshop invoices and payments (T-72).
model PostingSettings {
  companyId                String  @id @map("company_id") @db.Uuid
  labourRevenueAccountId   String? @map("labour_revenue_account_id") @db.Uuid
  receivableAccountId      String? @map("receivable_account_id") @db.Uuid
  cashAccountId            String? @map("cash_account_id") @db.Uuid
  cardAccountId            String? @map("card_account_id") @db.Uuid
  bankAccountId            String? @map("bank_account_id") @db.Uuid
  inventoryAccountId       String? @map("inventory_account_id") @db.Uuid
  goodsReceivedAccountId   String? @map("goods_received_account_id") @db.Uuid
  stockAdjustmentAccountId String? @map("stock_adjustment_account_id") @db.Uuid
  cogsAccountId            String? @map("cogs_account_id") @db.Uuid
  partsRevenueAccountId    String? @map("parts_revenue_account_id") @db.Uuid
  /// Supplier bills (T-76): what the company owes suppliers, recoverable input tax, price differences.
  payablesAccountId        String? @map("payables_account_id") @db.Uuid
  inputTaxAccountId        String? @map("input_tax_account_id") @db.Uuid
  priceVarianceAccountId   String? @map("price_variance_account_id") @db.Uuid
  version                  Int     @default(1)

  @@map("posting_settings")
  @@schema("accounting")
}

/// A posted workshop invoice (from an approved quote) or credit note (reversing an invoice in
/// full). Never changed once posted, except that an invoice records its credit note.
model Invoice {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  branchId         String   @map("branch_id") @db.Uuid
  jobId            String   @map("job_id") @db.Uuid
  quoteId          String   @map("quote_id") @db.Uuid
  /// invoice | credit_note
  kind             String
  number           String
  invoiceDate      DateTime @map("invoice_date") @db.Date
  currency         String   @db.Char(3)
  customerId       String   @map("customer_id") @db.Uuid
  customerName     String   @map("customer_name")
  subtotal         Decimal  @db.Decimal(14, 2)
  discountAmount   Decimal  @map("discount_amount") @db.Decimal(14, 2)
  netAmount        Decimal  @map("net_amount") @db.Decimal(14, 2)
  taxAmount        Decimal  @map("tax_amount") @db.Decimal(14, 2)
  total            Decimal  @db.Decimal(14, 2)
  taxCode          String?  @map("tax_code")
  taxPct           Decimal? @map("tax_pct") @db.Decimal(7, 4)
  pricesIncludeTax Boolean  @map("prices_include_tax")
  journalId        String   @unique @map("journal_id") @db.Uuid
  /// Invoice: cancelled by a credit note (the only change ever made to a posted invoice).
  credited         Boolean  @default(false)
  /// Credit note: the invoice it cancels, and why.
  creditOfId       String?  @unique @map("credit_of_id") @db.Uuid
  reason           String?
  createdBy        String   @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  job      JobCard       @relation(fields: [companyId, jobId], references: [companyId, id], onDelete: Restrict)
  quote    Quote         @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  creditOf Invoice?      @relation("credit", fields: [creditOfId], references: [id], onDelete: Restrict)
  creditBy Invoice?      @relation("credit")
  lines    InvoiceLine[]
  payments Payment[]

  @@unique([companyId, number])
  @@index([jobId])
  @@map("invoice")
  @@schema("workshop")
}

model InvoiceLine {
  invoiceId   String  @map("invoice_id") @db.Uuid
  lineNo      Int     @map("line_no")
  /// labour | part (hours = quantity, rate = unit price)
  kind        String  @default("labour")
  description String
  hours       Decimal @db.Decimal(12, 3)
  rate        Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@id([invoiceId, lineNo])
  @@map("invoice_line")
  @@schema("workshop")
}

/// Money received against an invoice; posted, never changed.
model Payment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  invoiceId      String   @map("invoice_id") @db.Uuid
  number         String
  /// cash | card | bank
  method         String
  amount         Decimal  @db.Decimal(14, 2)
  reference      String?
  idempotencyKey String   @map("idempotency_key")
  journalId      String   @unique @map("journal_id") @db.Uuid
  receivedBy     String   @map("received_by") @db.Uuid
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([companyId, number])
  @@unique([companyId, idempotencyKey])
  @@index([invoiceId])
  @@map("payment")
  @@schema("workshop")
}

/// A part in the company catalogue (T-74). Stock is held per branch.
model Part {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  sku       String
  name      String
  nameAr    String?  @map("name_ar")
  brand     String?
  unit      String
  /// Selling price per unit (owner; T-75). Null = not for sale yet.
  salePrice Decimal? @map("sale_price") @db.Decimal(12, 2)
  active    Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  stock     Stock[]
  movements StockMovement[]
  jobParts  JobPart[]

  @@unique([companyId, sku])
  @@unique([companyId, id])
  @@map("part")
  @@schema("inventory")
}

/// Quantity and value of a part at a branch (weighted average: average cost = value ÷ quantity).
model Stock {
  companyId String   @map("company_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  partId    String   @map("part_id") @db.Uuid
  onHand    Decimal  @default(0) @map("on_hand") @db.Decimal(14, 3)
  value     Decimal  @default(0) @db.Decimal(16, 2)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  part   Part   @relation(fields: [companyId, partId], references: [companyId, id], onDelete: Restrict)
  branch Branch @relation(fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict)

  @@id([branchId, partId])
  @@index([companyId, partId])
  @@map("stock")
  @@schema("inventory")
}

/// Every change of stock, posted to the ledger; never changed or deleted.
model StockMovement {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  partId         String   @map("part_id") @db.Uuid
  number         String
  /// receipt | adjustment_in | adjustment_out | issue | return
  kind           String
  /// Issue or return: the job the part went to.
  jobId          String?  @map("job_id") @db.Uuid
  /// Receipt: the supplier who delivered (T-76; older receipts have none).
  supplierId     String?  @map("supplier_id") @db.Uuid
  quantity       Decimal  @db.Decimal(14, 3)
  unitCost       Decimal  @map("unit_cost") @db.Decimal(14, 4)
  value          Decimal  @db.Decimal(16, 2)
  onHandAfter    Decimal  @map("on_hand_after") @db.Decimal(14, 3)
  valueAfter     Decimal  @map("value_after") @db.Decimal(16, 2)
  reference      String?
  reason         String?
  idempotencyKey String   @map("idempotency_key")
  journalId      String   @unique @map("journal_id") @db.Uuid
  createdBy      String   @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  part      Part               @relation(fields: [companyId, partId], references: [companyId, id], onDelete: Restrict)
  branch    Branch             @relation(fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict)
  supplier  Supplier?          @relation(fields: [companyId, supplierId], references: [companyId, id], onDelete: Restrict)
  billLines SupplierBillLine[]

  @@unique([companyId, number])
  @@unique([companyId, idempotencyKey])
  @@unique([companyId, id])
  @@index([branchId, partId, createdAt])
  @@index([supplierId])
  @@map("stock_movement")
  @@schema("inventory")
}

/// A part reserved for a job, then issued to it (cost to cost of parts sold), or released, or
/// returned to stock (T-75).
model JobPart {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  branchId         String    @map("branch_id") @db.Uuid
  jobId            String    @map("job_id") @db.Uuid
  partId           String    @map("part_id") @db.Uuid
  quantity         Decimal   @db.Decimal(14, 3)
  /// ordered | reserved | issued | returned | released | cancelled
  status           String    @default("reserved")
  /// Stock value taken out when issued (weighted average).
  cost             Decimal?  @db.Decimal(16, 2)
  issueMovementId  String?   @unique @map("issue_movement_id") @db.Uuid
  returnMovementId String?   @unique @map("return_movement_id") @db.Uuid
  /// Special order (T-77): ordered for this job because the branch had too little in stock.
  orderedAt        DateTime? @map("ordered_at") @db.Timestamptz(6)
  supplierId       String?   @map("supplier_id") @db.Uuid
  orderRef         String?   @map("order_ref")
  /// When delivered stock was reserved for it.
  arrivedAt        DateTime? @map("arrived_at") @db.Timestamptz(6)
  cancelReason     String?   @map("cancel_reason")
  createdBy        String    @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  job        JobCard     @relation(fields: [companyId, jobId], references: [companyId, id], onDelete: Restrict)
  part       Part        @relation(fields: [companyId, partId], references: [companyId, id], onDelete: Restrict)
  supplier   Supplier?   @relation(fields: [companyId, supplierId], references: [companyId, id], onDelete: Restrict)
  quoteLines QuoteLine[]

  @@index([jobId])
  @@index([branchId, partId, status])
  @@index([supplierId])
  @@map("job_part")
  @@schema("workshop")
}

// ── purchasing (T-76) ───────────────────────────────────────────────────────

model Supplier {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  name             String
  nameAr           String?  @map("name_ar")
  phone            String?
  email            String?
  taxNumber        String?  @map("tax_number")
  /// Days from the supplier's invoice date to its due date (0 = due on receipt).
  paymentTermsDays Int      @default(0) @map("payment_terms_days")
  active           Boolean  @default(true)
  version          Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  receipts StockMovement[]
  bills    SupplierBill[]
  jobParts JobPart[]

  @@unique([companyId, name])
  @@unique([companyId, id])
  @@map("supplier")
  @@schema("purchasing")
}

/// A supplier's invoice matched to the stock receipts it charges for, posted to the ledger:
/// Dr goods received (receipt values), Dr/Cr price variance, Dr input tax, Cr payables.
model SupplierBill {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String    @map("company_id") @db.Uuid
  branchId          String    @map("branch_id") @db.Uuid
  supplierId        String    @map("supplier_id") @db.Uuid
  number            String
  supplierInvoiceNo String    @map("supplier_invoice_no")
  billDate          DateTime  @map("bill_date") @db.Date
  dueDate           DateTime  @map("due_date") @db.Date
  currency          String    @db.Char(3)
  receiptsValue     Decimal   @map("receipts_value") @db.Decimal(14, 2)
  netAmount         Decimal   @map("net_amount") @db.Decimal(14, 2)
  varianceAmount    Decimal   @map("variance_amount") @db.Decimal(14, 2)
  varianceReason    String?   @map("variance_reason")
  taxCode           String?   @map("tax_code")
  taxPct            Decimal?  @map("tax_pct") @db.Decimal(7, 4)
  taxAmount         Decimal   @map("tax_amount") @db.Decimal(14, 2)
  total             Decimal   @db.Decimal(14, 2)
  idempotencyKey    String    @map("idempotency_key")
  journalId         String    @unique @map("journal_id") @db.Uuid
  /// Cancelled (unpaid only) by reversing its journal; the receipts can then be billed again.
  cancelled         Boolean   @default(false)
  cancelJournalId   String?   @unique @map("cancel_journal_id") @db.Uuid
  cancelReason      String?   @map("cancel_reason")
  cancelledBy       String?   @map("cancelled_by") @db.Uuid
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdBy         String    @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  supplier Supplier           @relation(fields: [companyId, supplierId], references: [companyId, id], onDelete: Restrict)
  branch   Branch             @relation(fields: [companyId, branchId], references: [companyId, id], onDelete: Restrict)
  lines    SupplierBillLine[]
  payments SupplierPayment[]

  @@unique([companyId, number])
  @@unique([companyId, idempotencyKey])
  @@unique([companyId, id])
  @@index([supplierId])
  @@map("supplier_bill")
  @@schema("purchasing")
}

/// One stock receipt charged on the bill, at the amount the supplier billed (before tax).
model SupplierBillLine {
  billId       String  @map("bill_id") @db.Uuid
  lineNo       Int     @map("line_no")
  companyId    String  @map("company_id") @db.Uuid
  movementId   String  @map("movement_id") @db.Uuid
  receiptValue Decimal @map("receipt_value") @db.Decimal(14, 2)
  amount       Decimal @db.Decimal(14, 2)
  /// False once the bill is cancelled (the only change ever made to a line).
  live         Boolean @default(true)

  bill     SupplierBill  @relation(fields: [billId], references: [id], onDelete: Restrict)
  movement StockMovement @relation(fields: [companyId, movementId], references: [companyId, id], onDelete: Restrict)

  @@id([billId, lineNo])
  @@index([movementId])
  @@map("supplier_bill_line")
  @@schema("purchasing")
}

model SupplierPayment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  billId         String   @map("bill_id") @db.Uuid
  number         String
  /// cash | bank
  method         String
  amount         Decimal  @db.Decimal(14, 2)
  reference      String?
  idempotencyKey String   @map("idempotency_key")
  journalId      String   @unique @map("journal_id") @db.Uuid
  paidBy         String   @map("paid_by") @db.Uuid
  paidAt         DateTime @default(now()) @map("paid_at") @db.Timestamptz(6)

  bill SupplierBill @relation(fields: [billId], references: [id], onDelete: Restrict)

  @@unique([companyId, number])
  @@unique([companyId, idempotencyKey])
  @@index([billId])
  @@map("supplier_payment")
  @@schema("purchasing")
}
