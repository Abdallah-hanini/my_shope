NODE_ENV=development
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# Matches docker-compose.yml defaults. Local synthetic credentials only.
DATABASE_URL=postgresql://erp:erp_local_dev_only@localhost:5432/erp?schema=public
# Used only by `pnpm db:migrate:check` to detect drift between migrations and schema.prisma.
SHADOW_DATABASE_URL=postgresql://erp:erp_local_dev_only@localhost:5432/erp_shadow
REDIS_CACHE_URL=redis://localhost:6379
REDIS_QUEUE_URL=redis://localhost:6380
LOG_LEVEL=info
