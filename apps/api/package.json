{
  "name": "@erp/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS modular-monolith API (REST /api/v1, OpenAPI, RFC 9457 errors).",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:check": "prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url \"$SHADOW_DATABASE_URL\" --exit-code",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "prisma generate && jest",
    "test:integration": "prisma generate && jest -c jest.integration.config.cjs --runInBand",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "openapi:generate": "pnpm run build && node dist/openapi.js ../../packages/contracts/openapi.json",
    "iam:bootstrap-admin": "node dist/cli/bootstrap-admin.js"
  },
  "dependencies": {
    "@erp/localization": "workspace:*",
    "@erp/validation": "workspace:*",
    "@nestjs/common": "11.2.12",
    "@nestjs/core": "11.2.12",
    "@nestjs/platform-express": "11.2.12",
    "@nestjs/swagger": "11.4.8",
    "@prisma/client": "6.19.3",
    "bullmq": "5.81.6",
    "exceljs": "4.4.0",
    "helmet": "8.1.0",
    "ioredis": "5.11.1",
    "jose": "5.10.0",
    "nestjs-pino": "5.3.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@erp/config": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.12",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.7",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "ts-jest": "29.4.15"
  }
}
