{
  "name": "@erp/customer-mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Customer native app (Expo). Separate package id, navigation and release pipeline from the manager app.",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform android --platform ios --output-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "@erp/api-client": "workspace:*",
    "@erp/design-tokens": "workspace:*",
    "@erp/localization": "workspace:*",
    "@erp/mobile-ui": "workspace:*",
    "@expo/metro-runtime": "6.1.2",
    "@tanstack/react-query": "5.108.4",
    "expo": "54.0.38",
    "expo-constants": "18.0.14",
    "expo-linking": "8.0.12",
    "expo-localization": "17.0.9",
    "expo-router": "6.0.24",
    "expo-secure-store": "15.0.8",
    "expo-status-bar": "3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0"
  },
  "devDependencies": {
    "@erp/config": "workspace:*",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.1.17",
    "jest": "29.7.0",
    "jest-expo": "54.0.18",
    "react-test-renderer": "19.1.0",
    "typescript": "5.9.3"
  }
}
