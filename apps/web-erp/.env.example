# Server-side only: where the Next.js server reaches the API.
API_INTERNAL_URL=http://localhost:4000

# Sign-in through the dev Keycloak from `pnpm auth:up` (same realm as production).
# Production values are set by deploy/docker-compose.prod.yml; production refuses to start without them.
WEB_PUBLIC_URL=http://localhost:3000
OIDC_ISSUER=http://localhost:8080/realms/erp
OIDC_CLIENT_ID=erp-web
OIDC_CLIENT_SECRET=erp_web_local_dev_only
# Development only. For any real server use: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
WEB_SESSION_SECRET=dev-only-session-secret-not-for-production-use
