{
  "name": "@erp/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "OpenAPI document generated from apps/api and the TypeScript types derived from it. Do not edit generated files by hand.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "openapi.json"
  ],
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/generated.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@erp/config": "workspace:*",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.7",
    "openapi-typescript": "7.13.0"
  }
}
