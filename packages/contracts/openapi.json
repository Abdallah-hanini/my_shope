  "info": {
    "title": "Automotive ERP API",
    "description": "REST /api/v1. Errors use RFC 9457 application/problem+json.",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LivenessDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up"
            ]
          },
          "uptimeSeconds": {
            "type": "number",
            "description": "Seconds since the process started"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "uptimeSeconds",
          "version"
        ]
      },
      "DependencyCheckDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "database",
              "cache",
              "queue"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          },
          "latencyMs": {
            "type": "number",
            "description": "Round-trip time of the check in milliseconds"
          },
          "error": {
            "type": "string",
            "description": "Short, non-sensitive failure reason"
          }
        },
        "required": [
          "name",
          "status",
          "latencyMs"
        ]
      },
      "HealthReportDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time",
            "description": "UTC time the checks ran (freshness)"
          },
          "version": {
            "type": "string"
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DependencyCheckDto"
            }
          }
        },
        "required": [
          "status",
          "checkedAt",
          "version",
          "checks"
        ]
      },
      "CreateCompanyDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "ACME"
          },
          "legalName": {
            "type": "string"
          },
          "legalNameAr": {
            "type": "string"
          },
          "baseCurrency": {
            "type": "string",
            "example": "QAR"
          },
          "timezone": {
            "type": "string",
            "example": "Asia/Qatar"
          },
          "initialAdminUserId": {
            "type": "string",
            "format": "uuid",
            "description": "Receives the company-admin role for all branches"
          }
        },
        "required": [
          "code",
