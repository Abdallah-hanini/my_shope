{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "operationId": "getLiveness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessDto"
                }
              }
            }
          }
        },
        "summary": "Process liveness. Does not check dependencies.",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReportDto"
                }
              }
            }
          },
          "503": {
            "description": "At least one dependency is down",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReportDto"
                }
              }
            }
          }
        },
        "summary": "Readiness: PostgreSQL, cache Redis and queue Redis.",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "Automotive ERP API",
    "description": "REST /api/v1. Errors use RFC 9457 application/problem+json.",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LivenessDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up"
            ]
          },
          "uptimeSeconds": {
            "type": "number",
            "description": "Seconds since the process started"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "uptimeSeconds",
          "version"
        ]
      },
      "DependencyCheckDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "database",
              "cache",
              "queue"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          },
          "latencyMs": {
            "type": "number",
            "description": "Round-trip time of the check in milliseconds"
          },
          "error": {
            "type": "string",
            "description": "Short, non-sensitive failure reason"
          }
        },
        "required": [
          "name",
          "status",
          "latencyMs"
        ]
      },
      "HealthReportDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          },
          "checkedAt": {
            "type": "string",
            "format": "date-time",
            "description": "UTC time the checks ran (freshness)"
          },
          "version": {
            "type": "string"
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DependencyCheckDto"
            }
          }
        },
        "required": [
          "status",
          "checkedAt",
          "version",
          "checks"
        ]
      },
      "ProblemDetailsDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "about:blank"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "number"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "description": "Request path"
          },
          "requestId": {
            "type": "string",
            "description": "Correlation id, also returned in the x-request-id header"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "instance"
        ]
      }
    }
  }
}
