# Shared helpers for the shop server scripts. Requires Windows PowerShell 5.1+ or PowerShell 7,
# Docker Desktop (WSL 2 engine) and Git. Every function stops on the first error.
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

$script:RepoRoot = (Resolve-Path (Join-Path $PSScriptRoot '..\..')).Path
$script:ComposeFile = Join-Path $script:RepoRoot 'deploy/docker-compose.prod.yml'
$script:EnvFile = Join-Path $script:RepoRoot 'deploy/.env'

function Get-ErpRepoRoot { $script:RepoRoot }
function Get-ErpEnvFile { $script:EnvFile }

function New-ErpSecret {
  <# 32 cryptographically random bytes, URL-safe Base64 without padding (43 characters). #>
  param([int]$Bytes = 32)
  $buffer = New-Object byte[] $Bytes
  $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
  try { $rng.GetBytes($buffer) } finally { $rng.Dispose() }
  [Convert]::ToBase64String($buffer).TrimEnd('=').Replace('+', '-').Replace('/', '_')
}

function Get-ErpPublicUrl {
  param([Parameter(Mandatory)][string]$SiteHost, [int]$HttpsPort = 443)
  if ($HttpsPort -eq 443) { "https://$SiteHost" } else { "https://${SiteHost}:$HttpsPort" }
}

function Test-ErpSiteHost {
  <# Accepts an IPv4 address or a DNS name; rejects URLs, ports and spaces. #>
  param([Parameter(Mandatory)][string]$SiteHost)
  $ip = $null
  if ([System.Net.IPAddress]::TryParse($SiteHost, [ref]$ip)) { return $ip.AddressFamily -eq 'InterNetwork' }
  return $SiteHost -match '^(?=.{1,253}$)([A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$'
}

function New-ErpEnvContent {
  <# Renders deploy/.env content. Pure function (no I/O) so it can be tested. #>
  param(
    [Parameter(Mandatory)][string]$SiteHost,
    [Parameter(Mandatory)][string]$BackupDir,
    [int]$HttpsPort = 443,
    [hashtable]$Secrets
  )
  if (-not (Test-ErpSiteHost $SiteHost)) { throw "SiteHost '$SiteHost' must be an IPv4 address or host name (no https://, no port)." }
  if (-not $Secrets) {
    $Secrets = @{
      POSTGRES_PASSWORD = New-ErpSecret
      KEYCLOAK_DB_PASSWORD = New-ErpSecret
      KC_BOOTSTRAP_ADMIN_PASSWORD = New-ErpSecret
      ERP_WEB_CLIENT_SECRET = New-ErpSecret
    }
  }
  $backup = $BackupDir.Replace('\', '/')
  @(
    '# Generated by deploy/windows/install.ps1. Contains secrets: keep this file private and backed up offline.'
    "ERP_SITE_HOST=$SiteHost"
    "ERP_HTTPS_PORT=$HttpsPort"
    "ERP_PUBLIC_URL=$(Get-ErpPublicUrl -SiteHost $SiteHost -HttpsPort $HttpsPort)"
    "ERP_BACKUP_DIR=$backup"
    'BACKUP_INTERVAL_HOURS=6'
    'BACKUP_RETENTION_DAYS=30'
    "POSTGRES_PASSWORD=$($Secrets.POSTGRES_PASSWORD)"
    "KEYCLOAK_DB_PASSWORD=$($Secrets.KEYCLOAK_DB_PASSWORD)"
    "KC_BOOTSTRAP_ADMIN_PASSWORD=$($Secrets.KC_BOOTSTRAP_ADMIN_PASSWORD)"
    "ERP_WEB_CLIENT_SECRET=$($Secrets.ERP_WEB_CLIENT_SECRET)"
  ) -join "`n"
}

function Read-ErpEnv {
  if (-not (Test-Path $script:EnvFile)) { throw "deploy/.env not found. Run install.ps1 first." }
  $values = @{}
  foreach ($line in Get-Content $script:EnvFile) {
    if ($line -match '^\s*([A-Z0-9_]+)\s*=\s*(.*)\s*$') { $values[$Matches[1]] = $Matches[2] }
  }
  $values
}

function Invoke-ErpCompose {
  <# docker compose against the production file and deploy/.env; throws on a non-zero exit code. #>
  param([Parameter(ValueFromRemainingArguments)][string[]]$Arguments)
  & docker compose -f $script:ComposeFile --env-file $script:EnvFile @Arguments
  if ($LASTEXITCODE -ne 0) { throw "docker compose $($Arguments -join ' ') failed with exit code $LASTEXITCODE" }
}

function Assert-ErpPrerequisites {
  if (-not (Get-Command docker -ErrorAction SilentlyContinue)) {
    throw 'Docker is not installed. Install Docker Desktop (WSL 2 engine) and start it.'
  }
  & docker info --format '{{.ServerVersion}}' *> $null
  if ($LASTEXITCODE -ne 0) { throw 'Docker Desktop is not running. Start it and wait until it says "Engine running".' }
  & docker compose version *> $null
  if ($LASTEXITCODE -ne 0) { throw 'docker compose is not available. Update Docker Desktop.' }
}

function Write-ErpStep { param([string]$Message) Write-Host "==> $Message" -ForegroundColor Cyan }

Export-ModuleMember -Function *-Erp*
