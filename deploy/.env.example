# Shop server settings. install.ps1 creates deploy/.env from this file with random secrets.
# Never commit deploy/.env.

# How staff devices reach the server: the shop PC's fixed LAN IP or a local hostname.
ERP_SITE_HOST=192.168.1.50
# HTTPS port on the PC (443 normally).
ERP_HTTPS_PORT=443
# Must match ERP_SITE_HOST and ERP_HTTPS_PORT (omit :443).
ERP_PUBLIC_URL=https://192.168.1.50

# Where database backups are written on the PC (ideally a second disk or a USB drive).
ERP_BACKUP_DIR=D:/ERP-Backups
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30

# Secrets (install.ps1 generates each with 32 random bytes).
POSTGRES_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me
ERP_WEB_CLIENT_SECRET=change-me
WEB_SESSION_SECRET=change-me
